<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
  </configSections>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb"/>
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer"/>
    </providers>
  </entityFramework>

  <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
   </startup>
  <connectionStrings>
    <add name="OnboardingEntities" connectionString="metadata=res://*/Model.OnboardingModel.csdl|res://*/Model.OnboardingModel.ssdl|res://*/Model.OnboardingModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(local);initial catalog=ONBOARDING1;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
    <add name="PATRONEntities" connectionString="metadata=res://*/Model.PatronModel.csdl|res://*/Model.PatronModel.ssdl|res://*/Model.PatronModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(local);initial catalog=SMUDAP1;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
  </connectionStrings>

  <appSettings>
    <add key="emailFrom" value="hendryw@smu.edu.sg"/>
    <add key="BatchJobNotificationTo" value="hendryw@smu.edu.sg"/>
    <add key="BatchJobNotificationSubject" value="Patron-Onboarding Interface (UAT)"/>
  </appSettings>
  <log4net>
    <appender name="LoggerRollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Logs/WebApi_"/>
      <appendToFile value="true"/>
      <rollingStyle value="Date"/>
      <datePattern value="yyyyMMdd.lo\g"/>
      <maxSizeRollBackups value="100"/>
      <maximumFileSize value="10000KB"/>
      <staticLogFileName value="false"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level - %message%newline"/>
      </layout>
    </appender>
    <logger name="Logger">
      <level value="INFO"/>
      <appender-ref ref="LoggerRollingFileAppender"/>
    </logger>
  </log4net>

  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="localhost" port="25"/>
      </smtp>
    </mailSettings>
  </system.net>
  
</configuration>
