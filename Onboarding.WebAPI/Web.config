<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <connectionStrings>
    <!--<add name="OnboardingEntities" connectionString="metadata=res://*/Model.OnboardingModel.csdl|res://*/Model.OnboardingModel.ssdl|res://*/Model.OnboardingModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(local);initial catalog=ONBOARDING;integrated security=True;;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
    <add name="PATRONEntities" connectionString="metadata=res://*/Model.PatronModel.csdl|res://*/Model.PatronModel.ssdl|res://*/Model.PatronModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(local);initial catalog=SMUDAP;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
    <add name="SecAccEntities" connectionString="metadata=res://*/Model.SecAccModel.csdl|res://*/Model.SecAccModel.ssdl|res://*/Model.SecAccModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(local);initial catalog=SECACC;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>-->
    <!--<add name="OnboardingEntities" connectionString="metadata=res://*/Model.OnboardingModel.csdl|res://*/Model.OnboardingModel.ssdl|res://*/Model.OnboardingModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=MSQLDDS1;initial catalog=ONBOARDING;integrated security=False;User ID=hendryw_rw;Password=Welcome!@#;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
    <add name="PATRONEntities" connectionString="metadata=res://*/Model.PatronModel.csdl|res://*/Model.PatronModel.ssdl|res://*/Model.PatronModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=MSQLDDS1;initial catalog=SMUDAP;integrated security=False;User ID=hendryw_rw;Password=Welcome!@#;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
    <add name="SecAccEntities" connectionString="metadata=res://*/Model.SecAccModel.csdl|res://*/Model.SecAccModel.ssdl|res://*/Model.SecAccModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=MSQLDDS1;initial catalog=SECACC;integrated security=False;User ID=hendryw_rw;Password=Welcome!@#;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>-->
    <add name="OnboardingEntities" connectionString="metadata=res://*/Model.OnboardingModel.csdl|res://*/Model.OnboardingModel.ssdl|res://*/Model.OnboardingModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=CORPUD21.staff.smu.edu.sg;initial catalog=ONBOARDING;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="PATRONEntities" connectionString="metadata=res://*/Model.PatronModel.csdl|res://*/Model.PatronModel.ssdl|res://*/Model.PatronModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=CORPUD21.staff.smu.edu.sg;initial catalog=SMUDAP;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="SecAccEntities" connectionString="metadata=res://*/Model.SecAccModel.csdl|res://*/Model.SecAccModel.ssdl|res://*/Model.SecAccModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=CORPUD21.staff.smu.edu.sg;initial catalog=SECACC;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  </connectionStrings>
  <appSettings>
    <add key="CacheExpiry" value="20" />
    <add key="UrgentRequestCutOff" value="7" />
    <add key="EmailFrom" value="Onboarding System&lt;onboarding-do-not-reply@smu.edu.sg&gt;" />
    <add key="ErrorMsgTo" value="hendryw@smu.edu.sg,abbasalihr@smu.edu.sg" />
    <add key="ErrorMsgSubject" value="Onboarding WebAPI Encountered An Error (DEV)" />
    <add key="NextTaskNotification_Subject" value="On-boarding System [Request ID: {RequestId}] - Pending your action {Urgency}" />
    <add key="NextTaskNotification_CC" value="" />
    <add key="NextTaskNotification_BCC" value="" />
    <add key="NextTaskNotification_Url" value="http://localhost:51544/Agent/AgentRequest/{RequestId}" />
    <add key="RequestNotification_Subject" value="On-boarding System [Request ID: {RequestId}] - For your information" />
    <add key="RequestNotification_CC" value="test_cc@test.example.com" />
    <add key="RequestNotification_BCC" value="" />
    <add key="RequestNotification_Url" value="http://localhost:51544/Requestor/PersonalInfo/{RequestId}" />
    <add key="RequestNotification_Submitted_Faculty_CC" value="faadmin@test.example.com" />
    <add key="RequestNotification_Submitted_CC" value="test_submitted_cc@test.example.com" />
	<add key="AESKeyFilePlain" value="C:\SourceCodes\Onboarding\Onboarding.WebAPI\AESKey.txt" />
    <add key="AESKeyFile" value="D:\Work\Operations\Onboarding\SourceCodes\Onboarding\Onboarding.WebAPI\AESKey.dat" />
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.5.2" />
    <httpCookies httpOnlyCookies="true" />
  </system.web>
  <system.webServer>
	<!--
    <security>
      <authorization>
        <remove users="*" roles="" verbs="" />
        <add accessType="Allow" users="SMUSTF\hendryw,SMUSTF\admhendryw,SMUSTF\abbasalihr" />
      </authorization>
    </security>
	-->
  <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers></system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="smtp.smu.edu.sg" port="25" />
      </smtp>
    </mailSettings>
  </system.net>
  <log4net>
    <appender name="LoggerRollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Logs/WebApi_" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd.lo\g" />
      <maxSizeRollBackups value="100" />
      <maximumFileSize value="10000KB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level - %message%newline" />
      </layout>
    </appender>
    <logger name="Logger">
      <level value="ON" />
      <appender-ref ref="LoggerRollingFileAppender" />
    </logger>
  </log4net>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:6 /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:14 /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>