@using MVCGrid.Web
@{
    ViewBag.Title = ViewBag.reqStatusName + " Tasks";
    Layout = "~/Views/Shared/CommonMaster.cshtml";
}
<style>
    .urgent_row {
        background-color:#f8c9cb!important;
    }
</style>

@if (ViewBag.ID == Onboarding.Entity.Constant.TaskStatusCode.Completed)
{
    @Html.MVCGrid("AgentGridCompleted", new { StatusCode = ViewBag.ID });
}
else
{
    @Html.MVCGrid("AgentGrid", new { StatusCode = ViewBag.ID });
}



<div class="row">
    <div class="col-md-3">
        <div class="form-inline">
            <div class="form-group">
                @if (ViewBag.ID == Onboarding.Entity.Constant.TaskStatusCode.Completed)
                {
                    <label>
                        Page Size: <select class="form-control" data-mvcgrid-type="pageSize" data-mvcgrid-name="AgentGridCompleted">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </label>
                }
                else
                {
                    <label>
                        Page Size: <select class="form-control" data-mvcgrid-type="pageSize" data-mvcgrid-name="AgentGrid">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </label>
                }
            </div>
        </div>
    </div>

</div>









