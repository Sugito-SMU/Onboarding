@model Onboarding.Models.AgentRequestModel

@{
    Onboarding.Entity.Task task = Model.Request.GetTask(Onboarding.Entity.Constant.TaskCode.CreateNTID);
    <p>
        <label>Assigned Network ID <span style="color:red">*</span></label>
        @if ((task.TaskStsCd != Onboarding.Entity.Constant.TaskStatusCode.Pending) || (!task.IsMyTask) || (Model.ViewOnly == true)|| !string.IsNullOrEmpty(Model.AssignedNTID))
        {
            @Html.EditorFor(m => m.AssignedNTID, new { htmlAttributes = new { @class = "form-control input_" + task.TaskCd + task.TaskId.ToString(), @autocomplete = "off", @readonly = "readonly", @maxlength = Onboarding.Entity.Constant.TaskAttributeLength.GetLength(Onboarding.Entity.Constant.TaskAttributeCode.AssignedNTID) } })
        }
        else
        {
            @Html.EditorFor(m => m.AssignedNTID, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @maxlength = Onboarding.Entity.Constant.TaskAttributeLength.GetLength(Onboarding.Entity.Constant.TaskAttributeCode.AssignedNTID) } })
        }
        @if ((task.ValidationError != null) && task.ValidationError.HasError(Onboarding.Entity.Constant.TaskAttributeCode.AssignedNTID))
        {
            <div>
                <span class="help-block text-danger checkbox_error_message">@task.ValidationError.GetErrorMessage(Onboarding.Entity.Constant.TaskAttributeCode.AssignedNTID)</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(ViewBag.TNTIDErrorMessage))
        {
            <div>
                <span class="help-block text-danger checkbox_error_message">@ViewBag.TNTIDErrorMessage</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(ViewBag.TNTIDMessage))
        {
            <div>
                <span class="help-block text-warning">@ViewBag.TNTIDMessage</span>
            </div>
        }
    </p>
}
