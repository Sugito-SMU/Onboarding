<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.7.2" />
      </system.Web>
  -->
  <system.web>
    <httpRuntime targetFramework="4.7.2" />
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="Syncfusion.EJ, Version=14.4450.0.15, Culture=neutral, PublicKeyToken=3d67ed1f87d44c89" />
        <add assembly="Syncfusion.EJ.Mvc, Version=14.4500.0.15, Culture=neutral, PublicKeyToken=3d67ed1f87d44c89" />
      </assemblies>
    </compilation>
    <authentication mode="None" />
    <authorization>
      <allow users="*" />
      <!-- <deny users="?" /> Denies anonymous users -->
      <!-- <deny users="*" /> Denies all users -->
    </authorization>
    <sessionState mode="InProc" timeout="60" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <customErrors mode="Off" defaultRedirect="~/error.htm" />
  </system.web>
  <appSettings>
    <add key="Debug_User" value="stanhwang" />
    <add key="owin:AppStartup" value="Onboarding.Startup" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="false" />
    <add key="CacheExpiry" value="20" />
    <add key="WebAPIUri" value="http://localhost:7465/" />
    <!--<add key="NaasAPIUri" value="http://localhost/CASWebAPI2/"/>-->
    <add key="InterfaceToNaas" value="true" />
    <add key="NaasAPIUri" value="http://miisdas2.devstf.smu.edu.sg/" />
    <add key="RSACertificateName" value="MIISDAS2.devstf.smu.edu.sg" />
    <!--<add key="RSACertificateName" value="web2.adlab.mycorp.com"/>-->
    <!--<add key="WebAPIUri" value="http://miisqa25.staff.smu.edu.sg/apps/OnboardingWebAPI/" />-->
    <!--<add key="WebAPIUri" value="http://miisqa25:8080/OnboardingWebAPI/" />-->
    <add key="AttachmentBaseFolder" value="D:\Work\Operations\Onboarding\Temp" />
    <add key="AttachmentMaxSize" value="3145728" />
    <add key="BulkRequestMaxSize" value="1000000" />
    <add key="BulkRequestMaxRows" value="200" />
    <add key="EISRequestURL" value="https://eisrequest.intranet.smu.edu.sg/Myservice/service_req_form.asp" />
    <add key="EmailFrom" value="Onboarding System&lt;onboarding-do-not-reply@smu.edu.sg&gt;" />
    <add key="ErrorMsgTo" value="hendryw@smu.edu.sg,abbasalihr@smu.edu.sg" />
    <add key="ErrorMsgSubject" value="Onboarding Encountered An Error (DEV)" />
    <add key="StaffDomain" value="devstf" />
    <add key="AdvanceStartDaysForAdjunct" value="56" />
    <add key="MSALKeyFilePlain" value="C:\SourceCodes\Onboarding\Onboarding\MSAL.txt" />
    <add key="Instance" value="https://login.microsoftonline.com/" />
    <add key="RedirectURL" value="https://onboarding-qa.intranet.smu.edu.sg/" />
  </appSettings>
  <log4net>
    <appender name="LoggerRollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Logs/Web_" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd.lo\g" />
      <maxSizeRollBackups value="100" />
      <maximumFileSize value="10000KB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level - %message%newline" />
      </layout>
    </appender>
    <logger name="Logger">
      <level value="ALL" />
      <appender-ref ref="LoggerRollingFileAppender" />
    </logger>
  </log4net>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    <add name="MVCGridHandler" verb="*" path="MVCGridHandler.axd" type="MVCGrid.Web.MVCGridHandler, MVCGrid" /></handlers></system.webServer>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="smtp.smu.edu.sg" port="25" />
      </smtp>
    </mailSettings>
  </system.net>
